generator client {
    provider     = "prisma-client"
    output       = "../src/generated/prisma"
    moduleFormat = "cjs"
}

datasource db {
    provider = "postgresql"
}

// ------------------------------------------------------
// ENUMS: PostgreSQL Native Types
// ------------------------------------------------------
enum EmploymentType {
	FULL_TIME
	PART_TIME
	CONTRACT
	FREELANCE
	INTERNSHIP
}

enum LocationType {
	ON_SITE
	HYBRID
	REMOTE
}

enum JobStatus {
	DRAFT
	PUBLISHED
	CLOSED
	EXPIRED
}
