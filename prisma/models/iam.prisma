// ------------------------------------------------------
// USER TABLE: Identity and Profile Information
// ------------------------------------------------------
model User {
    id           String  @id @default(uuid())
    email        String  @unique
    pendingEmail String?
    name         String
    image        String?
    isVerified   Boolean @default(false)

    // Foreign Keys & Relationships
    roleId String
    role   Role   @relation(fields: [roleId], references: [id], onDelete: Restrict)

    account          Account? // 1:1 relationship with Account
    sessions         Session[] // 1:N relationship with Session
    employerProfile  EmployerProfile? // 1:1 relationship with EmployerProfile
    applicantProfile ApplicantProfile? // 1:1 relationship with ApplicantProfile

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

// ------------------------------------------------------
// ACCOUNT TABLE: Authentication and Credentials
// ------------------------------------------------------
model Account {
    id String @id @default(uuid())

    // Foreign Key to User
    userId String @unique
    // Cascade delete: If a User is deleted, their Auth Account is destroyed automatically
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    passwordHash               String
    verificationToken          String?   @unique
    verificationTokenExpiresAt DateTime?
    resetToken                 String?   @unique
    resetTokenExpiresAt        DateTime?

    scheduledForDeletionAt DateTime?
    failedLoginAttempts    Int       @default(0)
    lockedUntil            DateTime?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

// ------------------------------------------------------
// SESSION TABLE: Multiple-Device Session Management
// ------------------------------------------------------
model Session {
    id     String @id @default(uuid())
    userId String
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    refreshTokenHash String   @unique
    userAgent        String?
    ipAddress        String?
    isRevoked        Boolean  @default(false)
    lastActiveAt     DateTime @default(now())
    expiresAt        DateTime

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([userId])
}

// ------------------------------------------------------
// ROLE TABLE: Dynamic RBAC Configuration
// ------------------------------------------------------
model Role {
    id          String  @id @default(uuid())
    code        String  @unique // Used for code checks: "ADMIN", "EMPLOYER", "APPLICANT"
    description String? // Used for UI/Admin panels: "Can browse jobs and submit applications"

    // Relationship back to Users
    users User[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}
