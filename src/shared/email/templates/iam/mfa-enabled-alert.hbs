<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="x-apple-disable-message-reformatting" />
		<title>Two-Factor Authentication Enabled</title>
		<style>
			@import url("https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap");
			* { font-family: "Inter", Arial, sans-serif; }
		</style>
	</head>
	<body style="margin:0;background:#f3f4f6;">
		<div style="display:none;max-height:0;overflow:hidden;opacity:0;">
			Two-Factor Authentication has been enabled on your account.
		</div>
		<table role="presentation" width="100%" cellpadding="0" cellspacing="0">
			<tr>
				<td align="center">
					<table class="container" role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:640px;margin:32px auto;">
						<tr>
							<td class="outer" style="padding:24px;background:#fff;">
								<table class="content" role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f3f4f6; border-radius:8px; padding:64px 40px; text-align:center;">
									<tr>
										<td>
											<h1 style="margin:0 0 16px; font-size:24px; font-weight:600; color:#14171e;">
												2FA is now active
											</h1>
											<p style="margin:0 auto 32px; max-width:400px; font-size:16px; line-height:1.6; color:#43454b;">
												Two-factor authentication (2FA) was just enabled for your account. You will now be prompted for a security code whenever you sign in.
												<br /><br />
												If you did not make this change, please check your account security immediately.
											</p>
											<a href="{{accountSettingsUrl}}" target="_blank" style="display:inline-block; padding:14px 24px; background:#14171e; color:#fff; text-decoration:none; border-radius:8px; font-size:15px; font-weight:500;">
												Manage Security Settings
											</a>
										</td>
									</tr>
								</table>
							</td>
						</tr>
					</table>
				</td>
			</tr>
		</table>
	</body>
</html>
