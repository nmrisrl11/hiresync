<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="x-apple-disable-message-reformatting" />
		<title>Two-Factor Authentication Disabled</title>
		<style>
			@import url("https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap");
			* { font-family: "Inter", Arial, sans-serif; }
		</style>
	</head>
	<body style="margin:0;background:#f3f4f6;">
		<div style="display:none;max-height:0;overflow:hidden;opacity:0;">
			WARNING: Two-Factor Authentication was disabled on your account.
		</div>
		<table role="presentation" width="100%" cellpadding="0" cellspacing="0">
			<tr>
				<td align="center">
					<table class="container" role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:640px;margin:32px auto;">
						<tr>
							<td class="outer" style="padding:24px;background:#fff;">
								<table class="content" role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#fef2f2; border-radius:8px; padding:64px 40px; text-align:center;">
									<tr>
										<td>
											<h1 style="margin:0 0 16px; font-size:24px; font-weight:600; color:#991b1b;">
												2FA has been turned off
											</h1>
											<p style="margin:0 auto 32px; max-width:400px; font-size:16px; line-height:1.6; color:#7f1d1d;">
												Two-factor authentication (2FA) was recently disabled on your account. Your account is now less secure.
												<br /><br />
												If you did not perform this action, your password may be compromised. Please reset your password and contact support immediately.
											</p>
											<a href="{{supportUrl}}" target="_blank" style="display:inline-block; padding:14px 24px; background:#dc2626; color:#fff; text-decoration:none; border-radius:8px; font-size:15px; font-weight:500;">
												Contact Support
											</a>
										</td>
									</tr>
								</table>
							</td>
						</tr>
					</table>
				</td>
			</tr>
		</table>
	</body>
</html>
