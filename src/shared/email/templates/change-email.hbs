<html dir="ltr" lang="en">
	<head>
		<meta content="text/html; charset=utf-8" http-equiv="Content-Type" />
		<meta name="x-apple-disable-message-reformatting" />
		<title>
			Change your email address
		</title>
		<style>
			@media (max-width: 600px) {
				.mobile_mt-0 {
					margin-top: 0rem !important;
				}
			}

			@media (max-width: 600px) {
				.mobile_px-2 {
					padding-right: 0.5rem !important;
					padding-left: 0.5rem !important;
				}
			}

			@media (max-width: 600px) {
				.mobile_px-6 {
					padding-right: 1.5rem !important;
					padding-left: 1.5rem !important;
				}
			}

			@media (max-width: 600px) {
				.mobile_py-12 {
					padding-bottom: 3rem !important;
					padding-top: 3rem !important;
				}
			}
		</style>
		<style>
			@import url("https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap");
		</style>
		<style>
			@font-face {
				font-family: "Inter";
				font-style: normal;
				font-weight: 400;
				mso-font-alt: "Arial";
				src: url(https://fonts.gstatic.com/s/inter/v20/UcCO3FwrK3iLTeHuS_nVMrMxCp50SjIw2boKoduKmMEVuOKfMZg.ttf)
					format("truetype");
			}

			* {
				font-family: "Inter", Arial, sans-serif;
			}
		</style>
		<style>
			@font-face {
				font-family: "Inter";
				font-style: normal;
				font-weight: 500;
				mso-font-alt: "Arial";
				src: url(https://fonts.gstatic.com/s/inter/v20/UcCO3FwrK3iLTeHuS_nVMrMxCp50SjIw2boKoduKmMEVuI6fMZg.ttf)
					format("truetype");
			}

			* {
				font-family: "Inter", Arial, sans-serif;
			}
		</style>
		<style>
			@font-face {
				font-family: "Inter";
				font-style: normal;
				font-weight: 600;
				mso-font-alt: "Arial";
				src: url(https://fonts.gstatic.com/s/inter/v20/UcCO3FwrK3iLTeHuS_nVMrMxCp50SjIw2boKoduKmMEVuGKYMZg.ttf)
					format("truetype");
			}

			* {
				font-family: "Inter", Arial, sans-serif;
			}
		</style>
	</head>

	<body dir="ltr" lang="en" style="background-color:rgb(243,244,246);margin:0">
		<table
			align="center"
			border="0"
			cellpadding="0"
			cellspacing="0"
			role="presentation"
			width="100%"
		>
			<tbody>
				<tr>
					<td
						dir="ltr"
						lang="en"
						style="background-color:rgb(243,244,246);margin:0rem;text-align:center;font-family:Inter,system-ui,Arial,sans-serif"
					>
						<div
							data-skip-in-text="true"
							style="display:none;overflow:hidden;line-height:1px;opacity:0;max-height:0;max-width:0"
						>
							Change your email address
						</div>
						<table
							align="center"
							border="0"
							cellpadding="0"
							cellspacing="0"
							class="mobile_mt-0"
							role="presentation"
							style="max-width:640px;margin-right:auto;margin-left:auto;margin-top:2rem;width:100%"
							width="100%"
						>
							<tbody>
								<tr style="width:100%">
									<td>
										<table
											align="center"
											border="0"
											cellpadding="0"
											cellspacing="0"
											role="presentation"
											width="100%"
										>
											<tbody>
												<tr>
													<td>
														<table
															align="center"
															border="0"
															cellpadding="0"
															cellspacing="0"
															class="mobile_px-2"
															role="presentation"
															style="background-color:rgb(255,255,255);padding-right:1.5rem;padding-left:1.5rem;padding-bottom:1rem;padding-top:1rem"
															width="100%"
														>
															<tbody>
																<tr>
																	<td>
																		<table
																			align="center"
																			border="0"
																			cellpadding="0"
																			cellspacing="0"
																			class="mobile_px-6 mobile_py-12"
																			role="presentation"
																			style="background-color:rgb(243,244,246);border-radius:8px;padding-right:40px;padding-left:40px;padding-bottom:64px;padding-top:64px;text-align:center"
																			width="100%"
																		>
																			<tbody>
																				<tr>
																					<td>
																						<table
																							align="center"
																							border="0"
																							cellpadding="0"
																							cellspacing="0"
																							role="presentation"
																							style="margin-bottom:0.75rem"
																							width="100%"
																						>
																							<tbody>
																								<tr>
																									<td>
																										<h1
																											style="font-size:28px;font-weight:600;letter-spacing:-0.084px;line-height:1.3;color:rgb(20,23,30);margin:0rem;font-family:Inter,system-ui,Arial,sans-serif"
																										>
																											We're almost there!
																										</h1>
																									</td>
																								</tr>
																							</tbody>
																						</table>
																						<p
																							style="font-size:16px;line-height:1.5;font-weight:420;letter-spacing:-0.048px;color:rgb(67,69,75);margin-right:auto;margin-left:auto;margin-top:0rem;margin-bottom:2rem;max-width:380px;text-align:center;font-family:Inter,system-ui,Arial,sans-serif"
																						>
																							We received a request to change the email address
																							associated with your account.
																							<br /><br />
																							To confirm this change, please verify your new email
																							address by clicking the button below.
																						</p>
																						<table
																							align="center"
																							border="0"
																							cellpadding="0"
																							cellspacing="0"
																							role="presentation"
																							style="margin-bottom:1.5rem;text-align:center"
																							width="100%"
																						>
																							<tbody>
																								<tr>
																									<td>
																										<a
																											href="{{confirmEmailChangeUrl}}"
																											style="line-height:1.5rem;text-decoration:none;display:inline-block;max-width:100%;mso-padding-alt:0px;background-color:rgb(20,23,30);font-size:16px;font-weight:420;letter-spacing:-0.048px;color:rgb(255,255,255);border-radius:0.5rem;padding-right:28px;padding-left:28px;padding-bottom:16px;padding-top:16px;text-align:center;font-family:Inter,system-ui,Arial,sans-serif"
																											target="_blank"
																										>
																											<span>
																												<!--[if mso]><i style="mso-font-width:466.6666666666667%;mso-text-raise:24px" hidden>&#8202;&#8202;&#8202;</i><![endif]-->
																											</span>
																											<span
																												style="max-width:100%;display:inline-block;line-height:120%;mso-padding-alt:0px;mso-text-raise:12px"
																											>
																												Confirm new email
																											</span>
																											<span>
																												<!--[if mso]><i style="mso-font-width:466.6666666666667%" hidden>&#8202;&#8202;&#8202;&#8203;</i><![endif]-->
																											</span>
																										</a>
																										<br />
																										<p
																											style="font-size: small; font-style: italic;"
																										>
																											This link expires in
																											<strong>{{expiresInText}}</strong>.
																										</p>
																									</td>
																								</tr>
																							</tbody>
																						</table>
																						<p
																							style="font-size:13px;line-height:1.5;font-weight:420;letter-spacing:-0.039px;color:rgb(123,125,129);margin-right:auto;margin-left:auto;margin-top:2rem;margin-bottom:0rem;max-width:400px;text-align:center;font-family:Inter,system-ui,Arial,sans-serif"
																						>
																							If you didn't request to change your email address,
																							you can safely ignore this email.
																						</p>
																					</td>
																				</tr>
																			</tbody>
																		</table>
																	</td>
																</tr>
															</tbody>
														</table>
													</td>
												</tr>
											</tbody>
										</table>
									</td>
								</tr>
							</tbody>
						</table>
					</td>
				</tr>
			</tbody>
		</table>
	</body>

</html>