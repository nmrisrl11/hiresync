<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="x-apple-disable-message-reformatting" />
		<title>New Application Received</title>

		<style>
			@import url("https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap");

			@font-face {
				font-family: "Inter";
				font-style: normal;
				font-weight: 400;
				src: url(https://fonts.gstatic.com/s/inter/v20/UcCO3FwrK3iLTeHuS_nVMrMxCp50SjIw2boKoduKmMEVuOKfMZg.ttf)
					format("truetype");
			}

			@font-face {
				font-family: "Inter";
				font-style: normal;
				font-weight: 500;
				src: url(https://fonts.gstatic.com/s/inter/v20/UcCO3FwrK3iLTeHuS_nVMrMxCp50SjIw2boKoduKmMEVuI6fMZg.ttf)
					format("truetype");
			}

			@font-face {
				font-family: "Inter";
				font-style: normal;
				font-weight: 600;
				src: url(https://fonts.gstatic.com/s/inter/v20/UcCO3FwrK3iLTeHuS_nVMrMxCp50SjIw2boKoduKmMEVuGKYMZg.ttf)
					format("truetype");
			}

			* {
				font-family: "Inter", Arial, sans-serif;
			}

			@media only screen and (max-width: 600px) {
				.container {
					margin-top: 0 !important;
				}

				.outer {
					padding: 8px !important;
				}

				.content {
					padding: 48px 24px !important;
				}
			}
		</style>
	</head>

	<body style="margin:0;background:#f3f4f6;">
		<div style="display:none;max-height:0;overflow:hidden;opacity:0;">
			You have a new applicant for the
			{{jobTitle}}
			position.
		</div>

		<table role="presentation" width="100%" cellpadding="0" cellspacing="0">
			<tr>
				<td align="center">
					<table
						class="container"
						role="presentation"
						width="100%"
						cellpadding="0"
						cellspacing="0"
						style="max-width:640px;margin:32px auto;"
					>
						<tr>
							<td class="outer" style="padding:24px;background:#fff;">
								<table
									class="content"
									role="presentation"
									width="100%"
									cellpadding="0"
									cellspacing="0"
									style="
									background:#f3f4f6;
									border-radius:8px;
									padding:64px 40px;
									text-align:center;
								"
								>
									<tr>
										<td>
											<h1
												style="
												margin:0 0 16px;
												font-size:28px;
												font-weight:600;
												line-height:1.3;
												color:#14171e;
											"
											>
												New Application Received
											</h1>

											<p
												style="
												margin:0 auto 32px;
												max-width:380px;
												font-size:16px;
												line-height:1.6;
												color:#43454b;
											"
											>
												Hello
												{{companyName}},
												<br /><br />
												<strong>{{applicantName}}</strong>
												has just applied for the
												<strong>{{jobTitle}}</strong>
												position.
												<br /><br />
												You can review their resume, optional cover letter, and complete profile
												from your applications dashboard.
											</p>

											<a
												href="{{employerApplicationsUrl}}"
												target="_blank"
												style="
												display:inline-block;
												padding:16px 28px;
												background:#14171e;
												color:#fff;
												text-decoration:none;
												border-radius:8px;
												font-size:16px;
											"
											>
												Review Applicant
											</a>

											<p
												style="
												margin:32px auto 0;
												max-width:400px;
												font-size:13px;
												line-height:1.6;
												color:#7b7d81;
											"
											>
												Remember to update the application status as you review candidates to keep
												them informed during the hiring process.
											</p>
										</td>
									</tr>
								</table>
							</td>
						</tr>
					</table>
				</td>
			</tr>
		</table>
	</body>
</html>